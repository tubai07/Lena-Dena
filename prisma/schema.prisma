generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  name         String
  passwordHash String?
  businesses   Business[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Business {
  id             String            @id @default(cuid())
  name           String
  category       String            @default("General Store")
  currency       String            @default("INR")
  currencySymbol String            @default("₹")
  upiId          String?
  phone          String?
  address        String?
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers      Customer[]
  transactions   Transaction[]
  reminders      Reminder[]
  notifications  Notification[]
  groups         Group[]
  settings       BusinessSettings?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Customer {
  id                  String        @id @default(cuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  phone               String
  email               String?
  address             String?
  notes               String?
  openingBalancePaisa Float         @default(0) // > 0: customer owes merchant; < 0: merchant owes customer
  currentBalancePaisa Float         @default(0) // dynamic synced balance
  status              String        @default("ACTIVE") // ACTIVE, SETTLED, INACTIVE
  transactions        Transaction[]
  reminders           Reminder[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, currentBalancePaisa])
  @@index([businessId, phone])
}

model Transaction {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String   // "CREDIT" (gave credit) or "PAYMENT" (received payment)
  amountPaisa   Float    // strictly positive amount in paise (supports high value numbers)
  paymentMethod String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, CARD, OTHER
  date          DateTime @default(now())
  description   String?
  billNumber    String?
  receiptNumber String?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, date])
}

model Reminder {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String   @default("WHATSAPP") // WHATSAPP, SMS, CALL
  message    String
  status     String   @default("SENT") // SENT, PENDING, FAILED
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([customerId])
}

model Notification {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   @default("SYSTEM") // OVERDUE, PAYMENT_RECEIVED, SYSTEM
  isRead     Boolean  @default(false)
  link       String?
  createdAt  DateTime @default(now())

  @@index([businessId, isRead])
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  autoRemindersEnabled  Boolean  @default(true)
  reminderFrequencyDays Int      @default(7)
  reminderTemplate      String   @default("Namaste {customer_name}, this is a friendly reminder from {business_name} that {amount} is pending on your khata account. Kindly settle the payment at your convenience. UPI ID: {upi_id}. Thank you!")
  defaultPaymentMethod  String   @default("CASH")
  preferredLanguage     String   @default("en") // en, hi, bn
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Group {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  category       String            @default("Trip") // Trip, Home, Dining, Event, Other
  currency       String            @default("INR")
  currencySymbol String            @default("₹")
  joinCode       String            @unique // e.g. "44A3B" (5 uppercase alphanumeric chars)
  simplifyDebts  Boolean           @default(true)
  members        GroupMember[]
  expenses       GroupExpense[]
  settlements    GroupSettlement[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([businessId])
  @@index([joinCode])
}

model GroupMember {
  id                  String            @id @default(cuid())
  groupId             String
  group               Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                String
  phone               String?
  upiId               String?
  isOwner             Boolean           @default(false)
  expensePayers       ExpensePayer[]
  splits              ExpenseSplit[]
  settlementsPaid     GroupSettlement[] @relation("PayerSettlements")
  settlementsReceived GroupSettlement[] @relation("ReceiverSettlements")
  createdAt           DateTime          @default(now())

  @@index([groupId])
}

model GroupExpense {
  id               String         @id @default(cuid())
  groupId          String
  group            Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description      String
  totalAmountPaisa Int            // Strictly integer paise (10000 = ₹100.00)
  category         String         @default("GENERAL") // FOOD, TRAVEL, STAY, SHOPPING, OTHER
  splitType        String         @default("EQUAL")   // EQUAL, EXACT, SHARES
  notes            String?
  date             DateTime       @default(now())
  payers           ExpensePayer[]
  splits           ExpenseSplit[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([groupId])
}

model ExpensePayer {
  id          String       @id @default(cuid())
  expenseId   String
  expense     GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId    String
  member      GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaisa Int          // Amount paid toward this bill

  @@index([expenseId])
  @@index([memberId])
}

model ExpenseSplit {
  id          String       @id @default(cuid())
  expenseId   String
  expense     GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId    String
  member      GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amountPaisa Int          // Amount owed for this bill
  shareValue  Float?       // Weight if splitType == SHARES

  @@index([expenseId])
  @@index([memberId])
}

model GroupSettlement {
  id            String      @id @default(cuid())
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId       String
  payer         GroupMember @relation("PayerSettlements", fields: [payerId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      GroupMember @relation("ReceiverSettlements", fields: [receiverId], references: [id], onDelete: Cascade)
  amountPaisa   Int         // Settlement amount in integer paise
  paymentMethod String      @default("UPI") // UPI, CASH, BANK_TRANSFER
  notes         String?
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([groupId])
}

